# Reference only — do not commit real secrets.
# These are configured in the Cloudflare Pages dashboard
# under Settings → Environment variables, NOT loaded by Vite.

# UPSTREAM_URL is the FULL URL of the lookup endpoint.
# The Pages Function POSTs JSON {token} to this URL.
UPSTREAM_URL=https://example.com/internal/v1/o
UPSTREAM_SECRET=replace-with-shared-bearer-token

# ── Dev-only ────────────────────────────────────────────────────────────────
# Unlike the two above, these ARE loaded by Vite (from .env / .env.local) and
# feed the mocked /api/order response served by `npm run dev`. They never reach
# the client bundle or a production build. Omit them and the mock returns 0.00
# with an empty wallet address.
MOCK_AMOUNT=19.99
MOCK_AMOUNT_PARTIAL=7.01
MOCK_WALLET=0x0000000000000000000000000000000000000000
# Optional: real order data from a local backend instead of the fixture above.
# MOCK_UPSTREAM_URL=http://127.0.0.1:8004/internal/v1/o
# MOCK_UPSTREAM_SECRET=the backend's WORKER_SHARED_SECRET
